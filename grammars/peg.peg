# PEG grammar (PEG dialect) used by babi.
#
# Syntax is modeled after classic PEG definitions.


grammar        <- definition+ EOF
definition     <- identifier LEFTARROW expression
expression     <- sequence (SLASH Sequence)*
sequence       <- prefix*
prefix         <- (AND / NOT)? suffix
suffix         <- primary (QUESTION / STAR / PLUS)?
primary        <- identifier !LEFTARROW
              / OPEN expression CLOSE
              / literal
              / class
              / DOT

identifier     <- ident_start ident_cont* spacing
ident_start    <- [A-Za-z_]
ident_cont     <- [A-Za-z0-9_]

literal        <- single_quoted / double_quoted
single_quoted  <- '\'' char_single* '\'' spacing
double_quoted  <- '"' char_double* '"' spacing
char_single    <- escape / (!'\'' .)
char_double    <- escape / (!'"' .)
escape         <- '\\' (['"\\nrt] / 'x' hex hex)
hex            <- [0-9A-Fa-f]

class          <- '[' class_item* ']' spacing
class_item     <- range / class_char
range          <- class_char '-' class_char
class_char     <- escape / (!']' .)

spacing        <- (_ / comment)*
comment        <- '#' (!'\n' .)* ('\n' / EOF)

LEFTARROW      <- '<-' Spacing
SLASH          <- '/' Spacing
AND            <- '&' Spacing
NOT            <- '!' Spacing
QUESTION       <- '?' Spacing
STAR           <- '*' Spacing
PLUS           <- '+' Spacing
OPEN           <- '(' Spacing
CLOSE          <- ')' Spacing
DOT            <- '.' Spacing
_              <- [ \t\n\r]
EOF            <- !.

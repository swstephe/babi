# PEG grammar (PEG dialect) used by babi.
#
# Syntax is modeled after classic PEG definitions.

grammar        <- definition+ EOF
definition     <- identifier '<-' expression
expression     <- sequence ('/' Sequence)*
sequence       <- prefix*
prefix         <- (AND / NOT)? suffix
suffix         <- primary (QUESTION / STAR / PLUS)?
primary        <- identifier !'<-'
              / '(' expression ')'
              / literal
              / class
              / DOT

identifier     <- [A-Za-z_] [A-Za-z0-9_]* spacing

literal        <- single_quoted / double_quoted
single_quoted  <- '\'' char_single* '\'' spacing
double_quoted  <- '"' char_double* '"' spacing
char_single    <- escape / (!'\'' .)
char_double    <- escape / (!'"' .)
escape         <- '\\' (['"\\nrt] / 'x' hex hex)
hex            <- [0-9A-Fa-f]

class          <- '[' class_item* ']' spacing
class_item     <- range / class_char
range          <- class_char '-' class_char
class_char     <- escape / (!']' .)

spacing        <- (_ / comment)*
comment        <- '#' (!'\n' .)* ('\n' / EOF)

LEFTARROW      <- '<-' spacing
SLASH          <- '/' spacing
AND            <- '&' spacing
NOT            <- '!' spacing
QUESTION       <- '?' spacing
STAR           <- '*' spacing
PLUS           <- '+' spacing
OPEN           <- '(' spacing
CLOSE          <- ')' spacing
DOT            <- '.' spacing
_              <- [ \t\n\r]
EOF            <- !.

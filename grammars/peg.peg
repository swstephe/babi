# PEG grammar (PEG dialect) used by babi.
#
# Syntax is modeled after classic PEG definitions.

Grammar        <- Definition+ EOF
Definition     <- Identifier '<-' Expression
Expression     <- Sequence ('/' Sequence)*
Sequence       <- Prefix*
Prefix         <- (AND / NOT)? Suffix
Suffix         <- Primary (QUESTION / STAR / PLUS)?
Primary        <- Identifier !'<-'
              / '(' Expression ')'
              / Literal
              / Class
              / DOT

Identifier     <- [A-Za-z_] [A-Za-z0-9_]* Spacing

Literal        <- SingleQuoted / DoubleQuoted
SingleQuoted   <- '\'' CharSingle* '\'' Spacing
DoubleQuoted   <- '"' CharDouble* '"' Spacing
CharSingle     <- Escape / (!'\'' .)
CharDouble     <- Escape / (!'"' .)
Escape         <- '\\' (['"\\nrt] / 'x' Hex Hex)
Hex            <- [0-9A-Fa-f]

CharClass      <- '[' ClassItem* ']' Spacing
ClassItem      <- Range / ClassChar
Range          <- ClassChar '-' ClassChar
ClassChar      <- Escape / (!']' .)

Whitespace     <- [ \t\n\r]
Spacing        <- (Whitespace / Comment)*
Comment        <- '#' (!'\n')* ('\n' / EOF)

LEFTARROW      <- '<-' Spacing
SLASH          <- '/' Spacing
AND            <- '&' Spacing
NOT            <- '!' Spacing
QUESTION       <- '?' Spacing
STAR           <- '*' Spacing
PLUS           <- '+' Spacing
OPEN           <- '(' Spacing
CLOSE          <- ')' Spacing
DOT            <- '.' Spacing
